{"tid": "ace_bigcode_python_fns_28138", "entry": "convert_to_html", "stage1": [5, 8], "stage2": [17, 40], "rate": 0.425, "wilson95": [0.2851, 0.5781], "admitted": true, "why": "in band", "task": {"tid": "ace_bigcode_python_fns_28138", "entry": "convert_to_html", "prompt": "You are given a list of strings representing file names in a folder. Each file name ends with '.txt'. Your task is to convert these file names into their corresponding HTML file names by replacing the '.txt' extension with '.html'. Write a function that takes a list of file names and returns a new list of the converted file names. For example, if the input is ['file1.txt', 'file2.txt'], the output should be ['file1.html', 'file2.html']. Notice that you can assume all provided file names will end with '.txt'.", "tests": ["assert convert_to_html(['example1.txt', 'example2.txt']) == ['example1.html', 'example2.html']", "assert convert_to_html(['testfile.txt']) == ['testfile.html']", "assert convert_to_html(['document.txt', 'report.txt', 'summary.txt']) == ['document.html', 'report.html', 'summary.html']", "assert convert_to_html(['fileA.txt', 'fileB.txt', 'fileC.txt']) == ['fileA.html', 'fileB.html', 'fileC.html']", "assert convert_to_html(['singlefile.txt']) == ['singlefile.html']", "assert convert_to_html([]) == []", "assert convert_to_html(['file1.txt', 'file2.txt', 'file3.txt']) == ['file1.html', 'file2.html', 'file3.html']", "assert convert_to_html(['data.txt', 'info.txt']) == ['data.html', 'info.html']", "assert convert_to_html(['example.txt', 'test.txt', 'sample.txt']) == ['example.html', 'test.html', 'sample.html']", "assert convert_to_html(['myfile.txt']) == ['myfile.html']", "assert convert_to_html(['a.txt', 'b.txt', 'c.txt']) == ['a.html', 'b.html', 'c.html']", "assert convert_to_html(['firstfile.txt', 'secondfile.txt']) == ['firstfile.html', 'secondfile.html']", "assert convert_to_html(['file1.txt', 'file2.txt', 'file3.txt', 'file4.txt']) == ['file1.html', 'file2.html', 'file3.html', 'file4.html']", "assert convert_to_html(['emptyfile.txt']) == ['emptyfile.html']", "assert convert_to_html(['one.txt']) == ['one.html']", "assert convert_to_html(['test1.txt', 'test2.txt', 'test3.txt', 'test4.txt']) == ['test1.html', 'test2.html', 'test3.html', 'test4.html']", "assert convert_to_html(['sample1.txt', 'sample2.txt']) == ['sample1.html', 'sample2.html']", "assert convert_to_html(['doc1.txt', 'doc2.txt']) == ['doc1.html', 'doc2.html']", "assert convert_to_html(['file001.txt']) == ['file001.html']"]}}
{"tid": "ace_evol_15234", "entry": "validate_alias", "stage1": [7, 8], "stage2": [21, 40], "rate": 0.525, "wilson95": [0.375, 0.6706], "admitted": true, "why": "in band", "task": {"tid": "ace_evol_15234", "entry": "validate_alias", "prompt": "Implement a function `validate_alias(alias: str) -> bool` that validates a given alias according to the following requirements:  \n1. The alias should only contain alphanumeric characters.  \n2. The length of the alias should not exceed 20 characters.  \nIf the alias is valid, the function should return `True`; otherwise, it should return `False`.", "tests": ["assert validate_alias('ValidAlias123') == True", "assert validate_alias('alias_with_underscore') == False", "assert validate_alias('AnotherValidAlias') == True", "assert validate_alias('A'*20) == True", "assert validate_alias('A'*21) == False", "assert validate_alias('ValidAlias!') == False", "assert validate_alias('') == False", "assert validate_alias('12345678901234567890') == True", "assert validate_alias('123456789012345678901') == False", "assert validate_alias('Valid123') == True", "assert validate_alias('Invalid@Alias') == False", "assert validate_alias('Spaces NotAllowed') == False", "assert validate_alias('Short') == True", "assert validate_alias('AnotherValid123') == True", "assert validate_alias('123456') == True", "assert validate_alias('ValidAlias_123') == False", "assert validate_alias('A!B@C#D$') == False", "assert validate_alias('ValidAlias1234567890') == True"]}}
