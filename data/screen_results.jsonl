{"tid": "ace_bigcode_python_fns_16679", "entry": "filter_code_hunks", "stage1": [6, 8], "stage2": [30, 40], "rate": 0.75, "wilson95": [0.5981, 0.8581], "admitted": true, "why": "in band", "task": {"tid": "ace_bigcode_python_fns_16679", "entry": "filter_code_hunks", "prompt": "You are given a list of strings, where each string represents a hunk of code or a file. Write a function `filter_code_hunks(hunks: List[str]) -> List[str]` that takes this list as input and returns a new list containing all the hunks that are non-empty. The output should preserve the original order of the hunks. If the input list is empty, return an empty list.", "tests": ["assert filter_code_hunks(['', 'code1', 'code2', '', 'code3']) == ['code1', 'code2', 'code3']", "assert filter_code_hunks(['file1', '', 'file2']) == ['file1', 'file2']", "assert filter_code_hunks(['', '', '']) == []", "assert filter_code_hunks(['code', '']) == ['code']", "assert filter_code_hunks([]) == []", "assert filter_code_hunks(['hunk1', 'hunk2', 'hunk3']) == ['hunk1', 'hunk2', 'hunk3']", "assert filter_code_hunks(['', 'hunk', '']) == ['hunk']", "assert filter_code_hunks(['a', 'b', 'c', '', 'd']) == ['a', 'b', 'c', 'd']", "assert filter_code_hunks(['a', '', 'b', '', 'c']) == ['a', 'b', 'c']", "assert filter_code_hunks(['', 'a', 'b', 'c']) == ['a', 'b', 'c']", "assert filter_code_hunks(['', '', 'a']) == ['a']", "assert filter_code_hunks(['hunk1', '', 'hunk3', '']) == ['hunk1', 'hunk3']", "assert filter_code_hunks(['', 'hunk']) == ['hunk']", "assert filter_code_hunks(['file1', 'file2', 'file3']) == ['file1', 'file2', 'file3']", "assert filter_code_hunks(['']) == []", "assert filter_code_hunks(['valid', '']) == ['valid']", "assert filter_code_hunks(['', 'valid1', 'valid2', '']) == ['valid1', 'valid2']", "assert filter_code_hunks(['', 'valid1', '', 'valid2', '', '']) == ['valid1', 'valid2']"]}}
